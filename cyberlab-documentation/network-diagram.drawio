<mxfile host="drawio">
  <diagram id="cyberlab-topology" name="Network Topology">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Cyberlab Network Topology&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#666666&quot;&gt;Physical and logical layout · example / sanitized addressing&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="480" height="50" as="geometry" />
        </mxCell>

        <!-- Internet / modem / firewall / switch -->
        <mxCell id="internet" value="Internet" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="575" y="30" width="110" height="65" as="geometry" />
        </mxCell>
        <mxCell id="modem" value="ISP Modem" style="shape=mxgraph.cisco.modems_and_phones.cable_modem;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeColor=#ffffff;strokeWidth=2;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="598" y="140" width="64" height="32" as="geometry" />
        </mxCell>
        <mxCell id="pfsense" value="" style="shape=mxgraph.cisco.security.firewall;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeColor=#ffffff;strokeWidth=2;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="598" y="225" width="64" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pfsense-label" value="&lt;b&gt;pfSense&lt;/b&gt; · Protectli VP2440&lt;br&gt;Gateways 10.27.10.1 – 10.27.70.1&lt;br&gt;DNS resolver · DHCP on VLANs 20–70" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="217" width="260" height="66" as="geometry" />
