        <mxCell id="e-modem-pfsense" value="WAN" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="modem" target="pfsense">
